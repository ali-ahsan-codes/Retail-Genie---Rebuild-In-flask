# Copy to .env locally. Generate independent secrets with secrets.token_hex(32).
APP_ENV=development
SECRET_KEY=
MASTER_SECRET=
DATABASE_URL=sqlite:///gyro_pulse_hybrid.db
CORS_ALLOWED_ORIGINS=https://your-domain.example
PORT=5200
# Production: APP_ENV=production, HTTPS, MySQL and strong secrets are required.

# Dedicated per-company hybrid deployment: configure explicitly before starting.
# Missing IDs/origin/separate database fail closed; no legacy stock writers allowed.
GYRO_DEPLOYMENT_MODE=dedicated
GYRO_COMPANY_ID=
GYRO_INSTANCE_ID=
GYRO_PUBLIC_BASE_URL=
