# Template for .env.retail-genie. install.ps1 creates this file with generated credentials.
FLASK_CONFIG=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
DATABASE_URL=mysql+pymysql://retail_genie_app:REPLACE_WITH_PASSWORD@127.0.0.1:3306/retail_genie?charset=utf8mb4

# Persistent private media storage. Never point this at Flask's static directory.
UPLOADS_DIR=

# The Flask CLI scheduler writes compressed MySQL dumps here by default.
# Install the MySQL client utilities on the app host and keep this directory private.
BACKUP_DIR=
# Optional least-privilege dump account URL. Must target the same server/database as DATABASE_URL.
BACKUP_DATABASE_URL=
MYSQLDUMP_PATH=mysqldump
BACKUP_TIMEOUT_SECONDS=7200
BACKUP_SCHEDULER_POLL_SECONDS=15

# Local development only. Set true behind HTTPS for the office server.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8

# In-memory rate limiting is suitable only for a single local development process.
# Use a private Redis URL if the production deployment has multiple workers.
RATELIMIT_STORAGE_URI=memory://

# Optional externally reachable base URL. Leave empty for LAN IP auto-detection.
# Set when deployed behind DNS/TLS/reverse-proxy, for example https://retail.example.com
PUBLIC_BASE_URL=

# Local runner only. For same-Wi-Fi phone/tablet access, set FLASK_HOST=0.0.0.0
# and allow TCP 5000 only on the private network in the host firewall.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# Optional SMTP for emailing printable commercial documents. Leave unset to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SENDER=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=15
