# Copy this file to .env and replace all placeholders. Never commit .env.
FLASK_CONFIG=development
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
DATABASE_URL=mysql+pymysql://retail_genie:REPLACE_WITH_PASSWORD@127.0.0.1:3306/retail_genie?charset=utf8mb4

# The Flask CLI scheduler writes compressed MySQL dumps here by default.
# Install the MySQL client utilities on the app host and keep this directory private.
BACKUP_DIR=
# Optional least-privilege dump account URL. Must target the same server/database as DATABASE_URL.
BACKUP_DATABASE_URL=
MYSQLDUMP_PATH=mysqldump
BACKUP_TIMEOUT_SECONDS=7200
BACKUP_SCHEDULER_POLL_SECONDS=15

# Local development only. Set true behind HTTPS for the office server.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_HOURS=8

# In-memory rate limiting is suitable only for a single local development process.
# Use a private Redis URL if the production deployment has multiple workers.
RATELIMIT_STORAGE_URI=memory://

# Development server settings. Keep localhost until the server is firewalled/configured.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true
